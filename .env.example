# Server
PORT=3000

# Adapter selection
# Available adapters: gsma-open-gateway, mock
# Set to "mock" or set MOCK_CAMARA=true to run without live operator APIs.
CAMARA_ADAPTER=gsma-open-gateway

# CAMARA OAuth2 client credentials
# Obtain these from the GSMA Open Gateway sandbox portal:
# https://opengateway.gsma.com/
#
# Telefonica sandbox example:
#   CAMARA_TOKEN_URL=https://sandbox.opengateway.telefonica.com/apigateway/v1/token
#   CAMARA_BASE_URL=https://sandbox.opengateway.telefonica.com/apigateway
#
# Replace with your operator's values for production.
CAMARA_TOKEN_URL=https://your-operator.example.com/oauth2/token
CAMARA_CLIENT_ID=your-client-id
CAMARA_CLIENT_SECRET=your-client-secret
CAMARA_SCOPE=dpv:FraudPreventionAndDetection#number-verification:verify

# CAMARA Number Verification endpoint
CAMARA_BASE_URL=https://your-operator.example.com
CAMARA_VERIFY_PATH=/number-verification/v0/verify

# Optional API headers (required by some operators)
CAMARA_API_KEY=

# Adapt response parsing for your operator implementation.
# GSMA Open Gateway (v0.5+) uses: devicePhoneNumberVerified
# Older / alternate operator implementations may use: verificationResult, status, result.code
CAMARA_RESULT_PATH=devicePhoneNumberVerified

# Values that should count as a successful verification
# GSMA Open Gateway returns a boolean, so "true" is the expected success value.
CAMARA_SUCCESS_VALUES=true

# For local testing without live operator APIs
MOCK_CAMARA=false
